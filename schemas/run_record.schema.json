{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uoa/drugs-surrogate-pipeline/schemas/run_record.schema.json",
  "title": "Pipeline run record",
  "description": "One per pipeline invocation. Written by WP-F to artifacts/{run_id}/ and to MLflow. An experiment not in the record did not happen.",
  "type": "object",
  "required": ["run_id", "started", "config", "config_hash", "provenance", "stages"],
  "properties": {
    "run_id": { "type": "string", "description": "ULID" },
    "label": { "type": ["string", "null"], "description": "Human tag, e.g. 'wp-d sweep 042'" },
    "work_package": { "type": ["string", "null"], "enum": ["A", "B", "C", "D", "E", "F", "integration", null] },
    "started": { "type": "string", "format": "date-time" },
    "finished": { "type": ["string", "null"], "format": "date-time" },
    "status": { "type": "string", "enum": ["running", "complete", "failed", "cancelled"] },

    "config": { "type": "object", "description": "Fully resolved configuration with defaults expanded. Flat keys per interfaces.md." },
    "config_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "manifest_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },

    "provenance": {
      "type": "object",
      "required": ["git_sha"],
      "properties": {
        "git_sha": { "type": "string" },
        "git_dirty": { "type": "boolean" },
        "image_digests": { "type": "object", "additionalProperties": { "type": "string" } },
        "model_weights": { "type": "object", "additionalProperties": { "type": "string" }, "description": "name -> sha256. 'Which weights produced this?' is asked on day 4." },
        "gpu_type": { "type": "string" },
        "gpu_count": { "type": "integer" }
      }
    },

    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "status", "n_items", "gpu_seconds", "wall_seconds"],
        "properties": {
          "stage": { "type": "string", "enum": ["S0", "S1", "S2", "S3", "S4", "S5", "S6", "S7"] },
          "status": { "type": "string", "enum": ["complete", "failed", "skipped", "cached"] },
          "n_items": { "type": "integer" },
          "n_failed": { "type": "integer", "default": 0 },
          "gpu_seconds": { "type": "number" },
          "wall_seconds": { "type": "number" },
          "queue_seconds": { "type": ["number", "null"], "description": "If queue_seconds > wall_seconds, run size is the wrong lever." },
          "peak_memory_gb": { "type": ["number", "null"] }
        }
      }
    },

    "metrics": {
      "type": "object",
      "description": "Metric name -> {value, ci_low, ci_high, n_bootstrap}. A metric without an interval at n~20 is not a result.",
      "additionalProperties": {
        "type": "object",
        "required": ["value"],
        "properties": {
          "value": { "type": "number" },
          "ci_low": { "type": ["number", "null"] },
          "ci_high": { "type": ["number", "null"] },
          "n_bootstrap": { "type": ["integer", "null"] },
          "unit": { "type": ["string", "null"] }
        }
      }
    },

    "notes": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
